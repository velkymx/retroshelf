{
  "name": "retroshelf",
  "productName": "RetroShelf",
  "version": "0.6.0",
  "description": "A local game library for DOS and SCUMM games, launched through DOSBox Staging and ScummVM with per-game optimized configs.",
  "main": "src/main/main.js",
  "author": "velkymx",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "start": "electron-forge start",
    "build:renderer": "vite build --config vite.renderer.config.mjs",
    "test": "node --test",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@velkymx/vibeui": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "electron": "^45.1.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "htmlparser2": "^12.0.0",
    "yauzl": "^3.4.0"
  }
}
